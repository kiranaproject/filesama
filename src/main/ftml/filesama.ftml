// @form TFileSamaWindow
//
// filesama — desktop file manager window chrome modelled in FTML.
// Declarative markup defines the menu bar, left places sidebar,
// content area with navigation toolbar, file table, status bar, and context menu.
//
Container {
  id: root;
  width: 1040;
  height: 680;

  MenuBar {
    id: menuBar;
    anchors.top: parent.top;
    anchors.left: parent.left;
    anchors.right: parent.right;
    height: 28;

    Menu {
      title: "File";
      MenuItem { id: newFolderItem; text: "New Folder";      shortcut: "Ctrl+Shift+N"; }
      Separator { }
      MenuItem { id: propertiesItem; text: "Properties";     shortcut: "Alt+Return"; }
      Separator { }
      MenuItem { id: quitItem;       text: "Quit";           shortcut: "Ctrl+Q"; }
    }

    Menu {
      title: "Edit";
      MenuItem { id: cutItem;       text: "Cut";            shortcut: "Ctrl+X"; }
      MenuItem { id: copyItem;      text: "Copy";           shortcut: "Ctrl+C"; }
      MenuItem { id: renameItem;    text: "Rename...";      shortcut: "F2"; }
      MenuItem { id: deleteItem;    text: "Move to Trash";  shortcut: "Delete"; }
      Separator { }
      MenuItem { id: selectAllItem; text: "Select All";     shortcut: "Ctrl+A"; }
    }

    Menu {
      title: "View";
      MenuItem { id: refreshItem;    text: "Refresh";        shortcut: "F5"; }
      Separator { }
      MenuItem { id: showHiddenItem; text: "Show Hidden Files"; checkable: true; shortcut: "Ctrl+H"; }
    }

    Menu {
      title: "Go";
      MenuItem { id: goHomeItem;      text: "Home";           shortcut: "Alt+Home"; }
      MenuItem { id: goDesktopItem;   text: "Desktop"; }
      MenuItem { id: goDocumentsItem; text: "Documents"; }
      MenuItem { id: goDownloadsItem; text: "Downloads"; }
      Separator { }
      MenuItem { id: goParentItem;    text: "Parent Directory"; shortcut: "Alt+Up"; }
      MenuItem { id: goRootItem;      text: "Root Filesystem"; }
    }

    Menu {
      title: "Tools";
      MenuItem { id: openTerminalItem; text: "Open Terminal Here"; shortcut: "Ctrl+Shift+T"; }
    }

    Menu {
      title: "Help";
      MenuItem { id: aboutItem; text: "About Samarinda Files"; }
    }
  }

  // ── Places Sidebar (Full height beneath menuBar, borderless like TFtFileDialog) ──
  Container {
    id: sidebar;
    anchors.top: menuBar.bottom;
    anchors.left: parent.left;
    anchors.bottom: statusBar.top;
    width: 190;
    padding: 0;
    style: "background-color: #f6f8fa; border: none; border-right: 1px solid #e2e8f0;";

    TreeView {
      id: placesTree;
      anchors.fill: parent;
      paddingX: 12;
      paddingY: 14;
      itemHeight: 28;
      indentWidth: 16;
      drawFrame: false;
      style: "background-color: transparent; border: none;";

      TreeNode {
        text: "Home";
        expanded: true;
      }
      TreeNode {
        text: "Desktop";
        expanded: true;
      }
      TreeNode {
        text: "Documents";
        expanded: true;
      }
      TreeNode {
        text: "Downloads";
        expanded: true;
      }
      TreeNode {
        text: "Pictures";
        expanded: true;
      }
      TreeNode {
        text: "Music";
        expanded: true;
      }
      TreeNode {
        text: "Videos";
        expanded: true;
      }
      TreeNode {
        text: "Root";
        expanded: true;
      }
    }
  }

  // ── Right Content Area ──
  Container {
    id: contentArea;
    anchors.top: menuBar.bottom;
    anchors.left: sidebar.right;
    anchors.right: parent.right;
    anchors.bottom: statusBar.top;
    padding: 8;

    // ── Navigation Toolbar ──
    Container {
      id: toolBar;
      anchors.top: parent.top;
      anchors.left: parent.left;
      anchors.right: parent.right;
      height: 34;
      padding: 0;

      Button {
        id: btnBack;
        x: 0; y: 2;
        width: 30; height: 30;
        icon: "nav-back";
        tooltip: "Back (Alt+Left)";
      }

      Button {
        id: btnForward;
        x: 34; y: 2;
        width: 30; height: 30;
        icon: "nav-forward";
        tooltip: "Forward (Alt+Right)";
      }

      Button {
        id: btnUp;
        x: 68; y: 2;
        width: 30; height: 30;
        icon: "nav-up";
        tooltip: "Parent Directory (Alt+Up)";
      }

      Button {
        id: btnHome;
        x: 102; y: 2;
        width: 30; height: 30;
        icon: "outline-home";
        tooltip: "Home (Alt+Home)";
      }

      PathBar {
        id: pathBar;
        anchors.left: btnHome.right;
        anchors.leftMargin: 6;
        anchors.right: btnNewFolder.left;
        anchors.rightMargin: 6;
        y: 2;
        height: 30;
        mode: "breadcrumbs";
        rootDisplayName: "Filesystem";
      }

      Button {
        id: btnNewFolder;
        anchors.right: btnHidden.left;
        anchors.rightMargin: 4;
        y: 2;
        width: 30; height: 30;
        icon: "new-folder";
        tooltip: "New Folder (Ctrl+Shift+N)";
      }

      Button {
        id: btnHidden;
        anchors.right: btnRefresh.left;
        anchors.rightMargin: 4;
        y: 2;
        width: 30; height: 30;
        icon: "hidden";
        tooltip: "Show Hidden Files (Ctrl+H)";
        isToggle: true;
      }

      Button {
        id: btnRefresh;
        anchors.right: searchEntry.left;
        anchors.rightMargin: 6;
        y: 2;
        width: 30; height: 30;
        icon: "refresh";
        tooltip: "Refresh (F5)";
      }

      Entry {
        id: searchEntry;
        anchors.right: parent.right;
        y: 2;
        width: 150;
        height: 30;
        placeholder: "Filter...";
      }
    }

    // ── File Table ──
    Table {
      id: fileTable;
      anchors.top: toolBar.bottom;
      anchors.topMargin: 6;
      anchors.left: parent.left;
      anchors.right: parent.right;
      anchors.bottom: parent.bottom;
      headerHeight: 28;
      rowHeight: 26;
      showGridlines: false;
      zebraStriping: true;
      multiSelect: false;

      TableColumn {
        title: "Name";
        width: 320;
        align: "left";
      }
      TableColumn {
        title: "Size";
        width: 90;
        align: "right";
      }
      TableColumn {
        title: "Modified";
        width: 140;
        align: "left";
      }
      TableColumn {
        title: "Type";
        width: 90;
        align: "left";
      }
    }
  }

  // ── Status Bar ──
  Container {
    id: statusBar;
    anchors.left: parent.left;
    anchors.right: parent.right;
    anchors.bottom: parent.bottom;
    height: 26;
    padding: 0;

    Text {
      id: statusText;
      anchors.left: parent.left;
      anchors.right: statusRight.left;
      anchors.verticalCenter: parent.verticalCenter;
      anchors.leftMargin: 10;
      anchors.rightMargin: 10;
      height: 20;
      text: "Loading...";
      font: "Sans 9";
    }

    Text {
      id: statusRight;
      anchors.right: parent.right;
      anchors.verticalCenter: parent.verticalCenter;
      anchors.rightMargin: 10;
      height: 20;
      text: "";
      font: "Sans 9";
      color: "#6c7086";
    }
  }

  PopupMenu {
    id: fileContextMenu;

    MenuItem {
      id: ctxOpenItem;
      text: "Open";
    }
    MenuItem {
      id: ctxOpenTerminalItem;
      text: "Open in Terminal";
    }
    Separator { }
    MenuItem {
      id: ctxCutItem;
      text: "Cut";
    }
    MenuItem {
      id: ctxCopyItem;
      text: "Copy";
    }
    MenuItem {
      id: ctxRenameItem;
      text: "Rename...";
    }
    MenuItem {
      id: ctxDeleteItem;
      text: "Move to Trash";
    }
    Separator { }
    MenuItem {
      id: ctxPropertiesItem;
      text: "Properties";
    }
  }
}
